# Template for the '.env' **next to this file**, the environment in operation.
# It is read twice: compose substitutes its values into 'compose.yaml', and the
# 'web' service receives it as its environment.
#
# For development there is a separate template at 'server/.env.example'.

# --- Application ---------------------------------------------------------
# Something long and random, for example from 'openssl rand -base64 48'.
SECRET_KEY=
# The key every backup is encrypted with, from the same command. At least 32
# characters, otherwise the application does not start. Keep a copy away from
# this machine: without the key no backup can be read, and nobody can change
# that. See DEPLOYMENT.md, "Backups".
BACKUP_KEY=
DEBUG=False
# The path of the Django admin: one of your own that ends with '/' and does not
# start with it, for example 'verwaltung-x7/'. The application does not start
# with this placeholder, an empty value, 'admin/' (where the decoy waits) or a
# path under or above one that opens without signing in ('api/', 'accounts/',
# 'users/' ...). Signed out, the path answers 404. Sign in on the website, then
# "Administration" in the account menu leads there (administrators only).
ADMIN_URL=a-path-of-your-own/

# Only what concerns the server goes here. The application's name, who runs it
# and the privacy text are set in the administration under "Appearance and
# operator", like the logo. See DEPLOYMENT.md, "Operator and privacy".

# --- E-mail --------------------------------------------------------------
# Mails are the link for "Forgot your password?", the invitation of a new
# account created without a password, the confirmation of a new e-mail address
# and the notifications about changes to an account. Without a server the mail ends up in the
# container log ('docker compose logs web'), nothing goes out, and a new account
# needs a password. With a server the sender is required, otherwise the application
# does not start. To try it without sending: Mailpit, see DEPLOYMENT.md.
# EMAIL_HOST=smtp.example.de
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=crosstally@example.de
# The default is STARTTLS on port 587. For implicit TLS on port 465,
# EMAIL_USE_SSL=true is enough. STARTTLS then switches itself off.
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# --- Language and time ---------------------------------------------------
# The server's language: 'de' or 'en'. It applies wherever nobody is signed in
# and is the default for every new account. Whoever signs in chooses in their
# account menu and keeps that choice.
LANGUAGE_CODE=de
# Time zone in operation, a name from the IANA list. Stored in UTC, shown in
# this zone.
TIME_ZONE=Europe/Berlin

# --- Database ------------------------------------------------------------
# Long and random like the two above, for example from 'openssl rand -base64 48'.
# Its "/" and "+" go through as they are. The database takes the password once,
# at its first start. Changed later here, it has to be changed in the database
# too ('ALTER USER').
POSTGRES_PASSWORD=
# POSTGRES_DB=crosstally
# POSTGRES_USER=crosstally

# --- Reachability --------------------------------------------------------
# What Caddy serves: your own domain. Caddy fetches the certificate for it
# itself. For that the name has to point to this machine in the DNS, and ports
# 80 and 443 have to be reachable from the internet. Without that, see
# DEPLOYMENT.md, "The certificate". ':80' instead only when something in front
# of Caddy already handles TLS ('tailscale serve', a proxy of the house). Then
# the three values under "Another proxy in front of Caddy" belong to it.
SITE_ADDRESS=crosstally.example.de
# The same name. Without it the application answers "Bad Request".
EXTRA_ALLOWED_HOSTS=crosstally.example.de
# Recommended: the same address with 'https://'. Behind Caddy Django compares
# the origin of a form with its own address, so forms work without it. It only
# matters when a proxy changes scheme or name on the way.
CSRF_TRUSTED_ORIGINS=https://crosstally.example.de
# On as soon as a proxy in front handles TLS. With Caddy from 'compose.yaml',
# always.
BEHIND_TLS_PROXY=true

# --- Which image ---------------------------------------------------------
# A fixed version: then this entry decides what runs, not the time of the last
# 'pull'. The template names the latest release, release-please keeps the line
# between the two markers up to date. 'latest' follows every release, 'main' is
# the working state between releases and 'main-1a2b3c4' one particular state
# of it.
# x-release-please-start-version
VERSION=0.1.0
# x-release-please-end
# Only when building the image here ('docker compose up --build'), and only for
# a name of your own for the version the account menu shows. Empty, the build
# takes the state of the checkout ('lokal-1a2b3c4'). A published image carries
# its tag by itself, and that number wins over this value.
# APP_VERSION=

# How many workers the application server keeps (default 4). Each serves one
# request at a time. A worker grows with PDFs and large import plans and keeps
# what it took. Fewer on a small machine, more if several managers evaluate
# while counting is going on. See DEPLOYMENT.md, "What the machine needs".
# GUNICORN_WORKERS=4

# How many seconds a database connection stays open instead of being rebuilt
# for every request (default 60). 0 closes it after every request.
# CONN_MAX_AGE=60

# --- Another proxy in front of Caddy -------------------------------------
# Only when something in front of Caddy handles TLS, that is with
# SITE_ADDRESS=:80. Then all three values are set. With your own domain none is.
#
# On which address of the machine Caddy listens. The default is all of them.
# If the proxy in front runs on the same machine, 127.0.0.1: then nobody gets to
# Caddy past it. If it runs on another machine, the address it reaches this one
# by.
# LISTEN_ADDRESS=127.0.0.1
#
# Whose 'X-Forwarded-*' headers Caddy accepts instead of replacing them with
# what it sees itself. The default is nobody. Name the proxy in front and
# nothing else: whoever is trusted picks their own address and gets past the
# lockout after too many failed attempts. 'tailscale serve' on the same machine
# arrives from the Docker network, and Docker takes its networks from
# 172.16.0.0/12. Narrower still is the gateway alone, which
# 'docker network inspect <folder>_default' shows. Several entries are separated
# by spaces. 'private_ranges' means all private networks and trusts everyone in
# the local network along with them.
# TRUSTED_PROXIES=172.16.0.0/12

# Behind Caddy the caller's address is in 'X-Forwarded-For'. The number says how
# many hops **before Caddy** appear in it. Caddy itself writes the header and is
# not listed. Directly onto Caddy: 0, the default. With 'tailscale serve' in
# front: 1. If the application counts wrong, it finds no address or a proxy's,
# and then locks everyone out at once.
# PROXY_COUNT=1

# --- HSTS ----------------------------------------------------------------
# How long the browser remembers that the site exists only over HTTPS. The
# promise cannot be revoked, so start short. Once the certificate is reliable,
# set it to 31536000 (one year). Only then can the site also go on the
# browsers' preload list.
# HSTS_SECONDS=300
