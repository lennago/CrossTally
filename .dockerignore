**/.ruff_cache/
**/.pytest_cache/
**/.venv/
server/VERSION
# Of '.git' only what names the checkout's state ('bin/version.sh'). Its
# content and not the name itself: a worktree's '.git' is a file and comes
# along, the version is then "unknown".
.git/*
