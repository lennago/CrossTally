{
    "name": "crosstally-pwa",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "description": "Zähl-App von CrossTally, offlinefähig, spricht mit /api/v1/.",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "icons": "node bin/icons.mjs",
        "screenshots": "node bin/screenshots.mjs",
        "format": "prettier --write \"src/**/*.{js,css,svelte}\" \"bin/*.mjs\" \"e2e/*.js\" \"playwright.config.js\" \"../server/static/js/*.js\" \"../server/static/site.css\"",
        "format:check": "prettier --check \"src/**/*.{js,css,svelte}\" \"bin/*.mjs\" \"e2e/*.js\" \"playwright.config.js\" \"../server/static/js/*.js\" \"../server/static/site.css\""
    },
    "dependencies": {
        "dexie": "^4.0.11",
        "svelte": "^5.57.2",
        "vite-plugin-pwa": "^2.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@vitest/coverage-v8": "^5.0.5",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^30.1.3",
        "playwright": "^1.63.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "workbox-build": {
            "glob": "^13.0.6"
        }
    }
}
