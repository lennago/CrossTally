# Template for 'server/.env', the environment for development (venv, runserver).
# The real file is gitignored and stays that way. For operation with Docker
# there is a separate template next to 'compose.yaml'.

# Something long and random, for example from 'openssl rand -base64 48'.
SECRET_KEY=

# On for development: error pages with traceback, static files without
# 'collectstatic', '/app/' straight from the build folder.
DEBUG=True

DATABASE_URL=sqlite:///db.sqlite3

# The key the backups are encrypted with, from the same command as above.
# Optional here: without it 'bin/dumpdata.sh' and the button in the
# administration write readable states, as before. With real data in the
# database, better set one. Without 'DEBUG' it is required.
# BACKUP_KEY=

# The path of the Django admin: one of your own that ends with '/' and does not
# start with it, for example 'verwaltung-x7/'. The application does not start
# with this placeholder, an empty value, 'admin/' (where the decoy waits) or a
# path under or above one that opens without signing in ('api/', 'accounts/',
# 'users/' ...). Signed out, the path answers 404. Sign in on the website, then
# the menu "Administration" leads there.
ADMIN_URL=a-path-of-your-own/

# Only needed when accessing from a phone (see DEPLOYMENT.md):
# EXTRA_ALLOWED_HOSTS=machine.tailnet.ts.net
# CSRF_TRUSTED_ORIGINS=https://machine.tailnet.ts.net
# BEHIND_TLS_PROXY=true

# The application's name and who runs it are not set here but in the
# administration under "Appearance and operator". See DEPLOYMENT.md.

# --- Language and time ---------------------------------------------------
# The server's language: 'de' or 'en'. It applies wherever nobody is signed in
# and is the default for every new account. Whoever signs in chooses in their
# account menu and keeps that choice.
LANGUAGE_CODE=de
# Time zone in operation, a name from the IANA list. Stored in UTC, shown in
# this zone.
TIME_ZONE=Europe/Berlin

# --- Optional, with defaults ---------------------------------------------
# Where the administration writes its backups. Default: data/backups/complete
# below 'server/', next to the dumps of 'bin/full-dumpdata.sh'.
# BACKUP_DIR=
# Mail server for "Forgot your password?", the invitation of new accounts, the
# confirmation of a new e-mail address and the notifications about an account.
# Without it the mail only appears in the log, and a new account needs a
# password. 'DEFAULT_FROM_EMAIL' is required as soon as a server is set.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=
