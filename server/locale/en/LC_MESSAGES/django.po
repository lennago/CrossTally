#: katalog/ware_unit_change.py:98
#, python-format
msgid ""
"Von %(alt)s nach %(neu)s wechselt die Dimension. Wie viele %(neu)s eine "
"Einheit in %(alt)s ist, weiß nur, wer die Ware kennt: hier eintragen, oder "
"vorher bei den Umrechnungen der Ware. Ohne das ließen sich Gebinde und "
"Rezepturen nicht umrechnen."
msgstr ""
"From %(alt)s to %(neu)s the dimension changes. How many %(neu)s one unit in "
"%(alt)s is, is known only to whoever knows the product: enter it here, or "
"beforehand among the product's conversions. Without that, packs and recipes "
"could not be converted."

#: katalog/ware_unit_change.py:152
#, python-format
msgid ""
"Die Umrechnung der Ware wäre danach %(menge)s %(referenz)s je %(einheit)s. "
"Eine Umrechnung fasst höchstens %(grenze)s."
msgstr ""
"The conversion of the product would then be %(menge)s %(referenz)s per "
"%(einheit)s. A conversion holds at most %(grenze)s."

#: katalog/ware_unit_change.py:198
#, python-format
msgid ""
"Gebinde „%(name)s“ fasste danach weniger als %(menge)s %(einheit)s. So klein "
"lässt sich keine Menge führen."
msgstr ""
"The pack “%(name)s” would then hold less than %(menge)s %(einheit)s. No "
"quantity can be carried that small."

#: katalog/ware_unit_change.py:210
#, python-format
msgid ""
"Gebinde „%(name)s“ fasste danach %(menge)s %(einheit)s. Ein Gebinde fasst "
"höchstens %(grenze)s %(einheit)s."
msgstr ""
"The pack “%(name)s” would then hold %(menge)s %(einheit)s. A pack holds at "
"most %(grenze)s %(einheit)s."

#: katalog/ware_unit_change.py:223
#, python-format
msgid ""
"Die Gebinde „%(eines)s“ und „%(anderes)s“ fassten danach beide %(menge)s "
"%(einheit)s und ließen sich nicht mehr unterscheiden."
msgstr ""
"The packs “%(eines)s” and “%(anderes)s” would then both hold %(menge)s "
"%(einheit)s and could no longer be told apart."

#: katalog/ware_unit_change.py:272
#, python-format
msgid ""
"In der Rezeptur von „%(name)s“ bliebe von dieser Ware in %(einheit)s nichts "
"übrig."
msgstr ""
"In the recipe of “%(name)s” nothing of this product would be left in "
"%(einheit)s."

#: katalog/ware_unit_change.py:280
#, python-format
msgid ""
"In der Rezeptur von „%(name)s“ stünden von dieser Ware danach %(menge)s "
"%(einheit)s. Eine Rezeptur fasst höchstens %(grenze)s %(einheit)s."
msgstr ""
"In the recipe of “%(name)s” this product would then come to %(menge)s "
"%(einheit)s. A recipe holds at most %(grenze)s %(einheit)s."

#: katalog/ware_unit_change.py:321
#, python-format
msgid ""
"„%(name)s“ in %(haus)s: 1 %(hauseinheit)s wäre danach %(menge)s %(einheit)s. "
"Eine Umrechnung fasst höchstens %(grenze)s."
msgstr ""
"“%(name)s” at %(haus)s: 1 %(hauseinheit)s would then be %(menge)s "
"%(einheit)s. A conversion holds at most %(grenze)s."

