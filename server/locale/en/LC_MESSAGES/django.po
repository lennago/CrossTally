msgid "E-Mail-Adresse ändern"
msgstr "Change e-mail address"

#: templates/accounts/email_change.html:17
#, python-format
msgid "Zurzeit gilt <strong>%(email)s</strong>."
msgstr "Currently <strong>%(email)s</strong> applies."

#: templates/accounts/email_change.html:19
#, python-format
msgid ""
"An die neue Adresse geht eine Mail mit einem Link. Erst wenn du ihn "
"bestätigt hast, gilt sie. Der Link gilt einen Tag."
msgid_plural ""
"An die neue Adresse geht eine Mail mit einem Link. Erst wenn du ihn "
"bestätigt hast, gilt sie. Der Link gilt %(tage)s Tage."
msgstr[0] ""
"A mail with a link goes to the new address. It applies once you have "
"confirmed it. The link lasts one day."
msgstr[1] ""
"A mail with a link goes to the new address. It applies once you have "
"confirmed it. The link lasts %(tage)s days."

#: templates/accounts/email_change.html:21
msgid "Die neue Adresse gilt sofort."
msgstr "The new address applies at once."

#: templates/accounts/email_change.html:37
#: templates/accounts/passkey_list.html:41
#: templates/accounts/passkey_list.html:146
