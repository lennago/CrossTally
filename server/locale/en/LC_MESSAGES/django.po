msgstr "discontinued since %(datum)s"

#: templates/inventur/sollbestand.html:124
#, python-format
msgid "Dieselbe Ware führt das Haus jetzt aktiv unter %(nummer)s „%(name)s“."
msgstr ""
"The site now actively carries the same product under %(nummer)s “%(name)s”."

#: templates/inventur/sollbestand.html:138
#, python-format
msgid "Bei %(nummer)s dazurechnen"
msgstr "Add to %(nummer)s"

#: templates/inventur/sollbestand.html:145
#: templates/inventur/sollbestand.html:188
msgid "Neu anlegen"
msgstr "Create new"

#: templates/inventur/sollbestand.html:162
msgid "Nummer unbekannt: anlegen?"
msgstr "Unknown number: create it?"

#: templates/inventur/sollbestand.html:168
#, python-format
msgid "%(name)s kennt diese Nummern nicht."
msgstr "%(name)s does not know these numbers."

#: templates/inventur/sollbestand.html:178
