msgstr "used by no site"

#: templates/katalog/warengruppe_list.html:74
#, python-format
msgid "Alle Hausartikel aus „%(gruppe)s“ in diese Inventurart setzen?"
msgstr "Put all articles from “%(gruppe)s” into this inventory type?"

