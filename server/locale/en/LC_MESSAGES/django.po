msgstr "Number, name, product, article group, family or EAN"

#: katalog/forms/filters.py:685
msgid "Name der Warengruppe"
msgstr "Name of the article group"

#: katalog/forms/filters.py:728
msgid "Name oder Zutat"
msgstr "Name or ingredient"

#: katalog/forms/filters.py:733
msgid "Aktiv (alle Zutaten aktiv)"
msgstr "Active (all ingredients active)"

#: katalog/forms/filters.py:734
msgid "Inaktiv (eine Zutat inaktiv)"
msgstr "Inactive (one ingredient inactive)"

#: katalog/forms/filters.py:735
